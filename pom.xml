<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<!-- Metadatos del proyecto: Pastillero Inteligente -->
	<groupId>com.grupoj</groupId>
	<artifactId>pastillero-inteligente</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<name>Pastillero Inteligente</name>
	<description>Backend y servidor de gestión de tomas, alertas y notificaciones para el Pastillero Inteligente</description>

	<developers>
		<developer>
			<name>Germán Palomo de Miguel</name>
			<organization>Grupo J</organization>
		</developer>
		<developer>
			<name>Wasim Mohamed Hadir</name>
			<organization>Grupo J</organization>
		</developer>
		<developer>
			<name>Hamza Hassini El Mouhssine</name>
			<organization>Grupo J</organization>
		</developer>
	</developers>

	<properties>
		<java.version>21</java.version>
	</properties>

	<dependencies>
		<!-- API REST para comunicación WiFi con el Pastillero y las Apps (Médico/Familiar) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- Persistencia de datos para el historial de tomas, usuarios y horarios -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Base de datos en memoria H2 para desarrollo y pruebas -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Validación de datos de entrada (DNI, horarios, pesos) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Lombok para reducir código repetitivo en las entidades (Usuario, Paciente, Toma, Pastillero) -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- Pruebas unitarias y de integración -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>